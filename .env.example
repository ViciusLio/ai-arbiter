# Copy to .env for local development. Never commit .env.
#
# Every setting can be given as an environment variable: prefix ARBITER_, nested keys
# separated by a double underscore. Environment variables override arbiter.yaml.

# Path of the configuration file (default: ./arbiter.yaml)
# ARBITER_CONFIG=arbiter.yaml

# Database. SQLite for the standalone CLI, PostgreSQL for the gateway.
# ARBITER_DATABASE__URL=sqlite+aiosqlite:///./.arbiter/arbiter.db
# ARBITER_DATABASE__URL=postgresql+asyncpg://arbiter:CHANGE_ME@localhost:5432/arbiter

# Password of the local PostgreSQL container started by deploy/compose/compose.yaml.
# ARBITER_POSTGRES_PASSWORD=

# Secrets referenced from configuration as secret://NAME are read by the default secret
# store from ARBITER_SECRET_<NAME>: first from the environment, then from .env in the
# working directory. `arbiter init` generates the first two below in .env if they are not
# set anywhere.
#
# Keys the hash of API keys. At least 32 characters. Changing it invalidates every key.
# ARBITER_SECRET_API_KEY_PEPPER=
# Root secret for hashed redaction tags and prompt fingerprints.
# ARBITER_SECRET_REDACTION_KEY=
# Credentials of model providers, named as in the deployments of arbiter.yaml.
# ARBITER_SECRET_AZURE_OPENAI_KEY=

# Telemetry (needs the `otel` extra)
# ARBITER_TELEMETRY__ENABLED=true
# ARBITER_TELEMETRY__OTLP_ENDPOINT=http://localhost:4318
