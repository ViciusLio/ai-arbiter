# Settings for a live session of the consulting demonstration (docs/demo.md).
# From the root of a clone:   source examples/consulting/live.env
#
# They put the firm's internal regulation in front of `arbiter serve`, approve the Claude
# models and nothing else, and answer them with the mock provider: no real model is
# called. Every name here belongs to an invented firm.

REPO="${REPO:-$(pwd)}"
export ARBITER_POLICY__PACK="$REPO/src/ai_arbiter/scenarios/consulting/policy.yaml"
export ARBITER_POLICY__ALLOWED_MODELS='["claude-sonnet-5-5","claude-haiku-4-5"]'
export ARBITER_DEPLOYMENTS='[{"name":"claude","provider":"mock","model":"claude-sonnet-5-5","serves":["claude-sonnet-5-5","claude-haiku-4-5"],"priced_as":"mock-small","region":"local"}]'
